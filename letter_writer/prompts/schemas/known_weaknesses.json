{
  "type": "json_schema",
  "json_schema": {
    "name": "known_weaknesses",
    "strict": false,
    "schema": {
      "type": "object",
      "properties": {
        "weaknesses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirement": {"type": "string"},
              "gap": {"type": "string"}
            },
            "required": ["requirement", "gap"]
          }
        }
      },
      "required": ["weaknesses"]
    }
  }
}
